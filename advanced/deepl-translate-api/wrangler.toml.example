# 模板文件：复制为 wrangler.toml 后使用
# 真实的 wrangler.toml 已被 .gitignore 排除（可能含账号相关配置）
#   cp wrangler.toml.example wrangler.toml

name = "deepl-rain-9890"
main = "deepl-translate-api.js"
compatibility_date = "2026-09-26"

[[kv_namespaces]]
binding = "DEEPL_KV"
# 在 Cloudflare 控制台 → Workers & Pages → KV 中创建后填入
id = "<你的 KV namespace id>"

# 密钥不入库，统一存于 ../SECRETS.local.md
# 部署前注入一次即可（之后保留在 Cloudflare 侧）：
#   npx wrangler secret put DEEPL_API_KEY
#   npx wrangler secret put CLIENT_API_KEY
# 本地调试可用 .dev.vars（同样不入库）
[vars]
