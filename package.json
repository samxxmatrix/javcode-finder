{
  "name": "javcode-finder-extension",
  "description": "JavCode Finder browser extension",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "prepare": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "release": "node scripts/release.ts",
    "e2e:proxy": "node docs/scripts/vercel-e2e.mjs"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.2.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wxt": "^0.21.4"
  }
}
